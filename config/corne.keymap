#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        hrm-L-shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <16 37>;
        };

        hrm-R-shift {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <19 40>;
        };

        hrm-L-alt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <15 37>;
        };

        hrm-R-alt {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <20 40>;
        };

        hrm-L-ctrl {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <14 37>;
        };

        hrm-R-ctrl {
            bindings = <&kp RIGHT_CONTROL>;
            key-positions = <21 40>;
        };

        hrm-L-gui {
            bindings = <&kp LEFT_GUI>;
            key-positions = <13 37>;
        };

        hrm-R-gui {
            bindings = <&kp RIGHT_GUI>;
            key-positions = <22 40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp ESC    &kp Q  &kp W  &kp E       &kp R      &kp T    &kp Y  &kp U      &kp I          &kp O    &kp P     &kp BSPC
&kp TAB    &kp A  &kp S  &kp D       &kp F      &kp G    &kp H  &kp J      &kp K          &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z  &kp X  &kp C       &kp V      &kp B    &kp N  &kp M      &kp COMMA      &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                         &kp ESCAPE  &kp SPACE  &mo 1    &mo 2  &kp ENTER  &kp BACKSPACE
            >;
        };
        
        num-nav {
            bindings = <
&trans  &kp N6     &kp N7     &kp N8    &kp N9        &kp N0       &kp COMMA             &kp PERIOD             &kp DOUBLE_QUOTES  &kp SQT           &trans  &trans
&trans  &kp N1     &kp N2     &kp N3    &kp N4        &kp N5       &kp LEFT              &kp DOWN               &kp UP             &kp RIGHT         &trans  &trans
&trans  &kp EQUAL  &kp MINUS  &kp PLUS  &kp ASTERISK  &kp SLASH    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LESS_THAN      &kp GREATER_THAN  &trans  &trans
                              &trans    &trans        &trans       &trans                &trans                 &trans
            >;
        };

        sym {
            bindings = <
&trans  &kp CARET        &kp AMPERSAND  &kp LS(ASTERISK)  &kp GRAVE   &kp TILDE      &kp QUESTION    &kp SLASH  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp BACKSLASH  &trans
&trans  &kp EXCLAMATION  &kp AT         &kp HASH          &kp DOLLAR  &kp PERCENT    &kp MINUS       &kp EQUAL  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp COLON      &trans
&trans  &trans           &trans         &trans            &trans      &trans         &kp UNDERSCORE  &kp PLUS   &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp PIPE       &trans
                                        &trans            &trans      &trans         &trans          &trans     &trans
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB     &kp N1        &kp N2        &kp N3        &kp N4        &kp N5          &kp N6    &kp N7    &kp N8    &kp N9     &kp N0  &kp BSPC
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &trans  &trans
&kp LSHFT   &trans        &trans        &trans        &trans        &trans          &trans    &trans    &trans    &trans     &trans  &trans
                                        &kp LGUI      &trans        &kp SPACE       &kp RET   &trans    &kp RALT
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB    &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&kp LCTRL  &trans    &trans  &trans    &trans    &trans       &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&kp LSHFT  &trans    &trans  &trans    &trans    &trans       &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                             &kp LGUI  &trans    &kp SPACE    &kp RET    &trans     &kp RALT
            >;
        };
    };
};
